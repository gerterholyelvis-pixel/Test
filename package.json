{
  "name": "goblin-king",
  "version": "0.9.0",
  "private": true,
  "description": "Goblin King: a multiplayer goblin heist in the browser (three.js client, Node + ws server).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node tests/run.js",
    "test:browser": "node tools/perfbench.js --presets low,high --views vault --frames 120 --budget",
    "gameinfo": "node tools/gameinfo.js",
    "gameinfo:pdf": "node tools/gameinfo-pdf.js",
    "build": "node tools/build.js",
    "start:prod": "node server.js --production",
    "check": "node tools/check.js",
    "smoke": "node tools/smoke.js",
    "release:check": "node tools/check.js && node tests/run.js && node tools/smoke.js --dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gerterholyelvis-pixel/test.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/gerterholyelvis-pixel/test/issues"
  },
  "homepage": "https://github.com/gerterholyelvis-pixel/test#readme",
  "dependencies": {
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
